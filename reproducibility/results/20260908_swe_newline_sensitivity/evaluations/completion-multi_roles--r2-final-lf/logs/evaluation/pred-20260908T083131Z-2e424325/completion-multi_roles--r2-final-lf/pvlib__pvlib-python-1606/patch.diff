-    niter = np.trunc(np.log(atol / (df['VH'] - df['VL'])) / np.log(phim1))
+    # Golden-section search cannot estimate iterations on a zero-width
+    # interval. In that case the optimum is already at the shared bound, and
+    # using atol as a floor avoids divide-by-zero warnings.
+    interval = np.abs(df['VH'] - df['VL'])
+    niter = np.trunc(np.log(atol / np.maximum(interval, atol)) / np.log(phim1))
